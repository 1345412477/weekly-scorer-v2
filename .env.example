# ─ 智友辰评分系统 生产环境配置 ──
# 复制为 .env 后修改以下配置项

# 认证密钥（必须修改为随机字符串，生成方式: python -c "import secrets; print(secrets.token_hex(32))"）
AUTH_SECRET_KEY=your-random-secret-key-here

# 管理员密码
ADMIN_PASSWORD=admin123

# 允许的前端地址（逗号分隔，部署到 192.168.1.119 时填写该 IP）
CORS_ALLOW_ORIGINS=http://192.168.1.119

# AI 模型配置（火山引擎豆包）
ARK_API_KEY=your_ark_api_key_here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
SCORING_MODEL=doubao-seed-2.0-pro
VISION_MODEL=
AI_PROVIDER=ark
AI_TIMEOUT=60
AI_CONNECT_TIMEOUT=10

# ── 数据库配置 ──
# PostgreSQL（服务器部署推荐）
# Docker 容器访问宿主机数据库使用 host.docker.internal
DATABASE_URL=postgresql+asyncpg://user_tScewp:password_jaMRPK@host.docker.internal:5433/weekly_scorer

# 本地开发使用 SQLite（无需修改上面，注释掉 PostgreSQL 配置即可）
# DATABASE_URL=sqlite+aiosqlite:///./weekly_scorer.db
