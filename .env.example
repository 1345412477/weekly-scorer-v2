# ============================================
# 生产环境配置模板
# 复制为 .env 并修改对应值
# ============================================

# 数据库配置
# SQLite (开发/测试环境)
DATABASE_URL=sqlite+aiosqlite:///./weekly_scorer.db

# PostgreSQL (生产环境)
# DATABASE_URL=postgresql+asyncpg://ws_user:your_password@postgres:5432/weekly_scorer

DB_PASSWORD=your_secure_db_password_here

# 安全配置（必须修改）
AUTH_SECRET_KEY=your_random_secret_key_here_generate_with_openssl_rand_hex_32
ADMIN_PASSWORD=your_strong_admin_password_here

# CORS 配置（根据实际域名修改）
CORS_ALLOW_ORIGINS=https://your-domain.com,https://www.your-domain.com

# AI 服务配置
ARK_API_KEY=your_ark_api_key_here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
SCORING_MODEL=doubao-seed-2.0-pro
VISION_MODEL=
AI_TIMEOUT=60
AI_CONNECT_TIMEOUT=10

# Redis 配置（可选）
REDIS_URL=redis://redis:6379/0
